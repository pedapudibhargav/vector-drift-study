# OpenAI (only required for re-embed / L3 judge / smoke ingest)
OPENAI_API_KEY=

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (Vite)
VITE_API_BASE_URL=

# PostgreSQL + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vector_drift_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@vector-drift-postgres:5432/vector_drift_db

# L4 audit LLM assist (Review UI) — hard cap separate from ERB L3 budget
AUDIT_LLM_BUDGET_USD=2.0
AUDIT_LLM_MODEL=gpt-4o
# AUDIT_LLM_BASE_URL=   # optional OpenAI-compatible endpoint (e.g. Luna)
# AUDIT_LLM_PRICE_IN_PER_1M=2.50
# AUDIT_LLM_PRICE_OUT_PER_1M=10.00

# ---------------------------------------------------------------------------
# Optional private package mirrors — leave blank for public Docker Hub / PyPI / npm.
# Local mirror notes (if any) live under private/ (gitignored), not in this repo.
# ---------------------------------------------------------------------------
DOCKER_PYTHON_IMAGE=
DOCKER_NODE_IMAGE=
NPM_REGISTRY=
PYPI_INDEX_URL=
PIP_TRUSTED_HOST=
